---
// DitherSky: full-viewport ordered-dither field behind the landing page.
// One soft luminous arc in a duo-tone of the theme accent, a sparse
// starfield, and a slowly drifting noise field, quantised through an 8x8
// Bayer matrix. Rendered on the GPU at display refresh rate; a CPU path
// paints a single static frame when WebGL is unavailable.
//
// The sky is liquid: a coarse Navier-Stokes solver (diffuse, project,
// advect) runs on the CPU each frame, fed by pointer movement anywhere
// on the page. The velocity field and a short-lived trail of pointer
// points are uploaded to the shader, which warps the scene through them,
// lights the wake in a third tone, and lets the dither density boil
// where the flow runs strongest. Under reduced motion the field settles
// to the same static frame it always painted.
---

<div class="dither-sky" aria-hidden="true">
  <canvas class="dither-sky-canvas"></canvas>
</div>

<style>
  .dither-sky {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    contain: strict;
    /*
     * The slanted field occupies roughly the upper-right two-thirds and
     * melts along a diagonal parallel to the arc, so it never reaches the
     * lower-left corner where the lockup text lives.
     */
    -webkit-mask-image: linear-gradient(225deg, #000 0%, #000 32%, transparent 68%);
    mask-image: linear-gradient(225deg, #000 0%, #000 32%, transparent 68%);
  }

  @media (max-aspect-ratio: 3 / 4) {
    .dither-sky {
      /* Portrait: the lockup spans most of the width, so flatten the dissolve. */
      -webkit-mask-image: linear-gradient(205deg, #000 0%, #000 30%, transparent 56%);
      mask-image: linear-gradient(205deg, #000 0%, #000 30%, transparent 56%);
    }
  }

  .dither-sky-canvas {
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    opacity: 0;
    transition: opacity 1.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dither-sky.is-live .dither-sky-canvas {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .dither-sky-canvas {
      transition: none;
    }
  }
</style>

<script>
  type RGB = [number, number, number]

  interface Palette {
    bg: RGB
    ink: RGB
    ink2: RGB
    ink3: RGB
    star: RGB
    coverage: number
    maxInk: number
  }

  // 8x8 Bayer ordered-dither thresholds, normalised to (0, 1).
  const bayer = (() => {
    let matrix: number[][] = [
      [0, 2],
      [3, 1],
    ]
    for (let step = 0; step < 2; step++) {
      const size = matrix.length
      const next: number[][] = Array.from({ length: size * 2 }, () =>
        new Array<number>(size * 2).fill(0)
      )
      for (let y = 0; y < size; y++) {
        for (let x = 0; x < size; x++) {
          const base = 4 * matrix[y][x]
          next[y][x] = base
          next[y][x + size] = base + 2
          next[y + size][x] = base + 3
          next[y + size][x + size] = base + 1
        }
      }
      matrix = next
    }
    return matrix.flat().map(v => (v + 0.5) / 64)
  })()

  function hash(n: number): number {
    let t = n >>> 0
    t = Math.imul(t ^ (t >>> 16), 2246822519)
    t = Math.imul(t ^ (t >>> 13), 3266489917)
    t ^= t >>> 16
    return (t >>> 0) / 4294967296
  }

  // Tileable two-octave value noise, uploaded as a texture for the GPU and
  // sampled directly in the CPU fallback.
  const TEX = 128
  const noise = (() => {
    const smooth = (x: number) => x * x * (3 - 2 * x)
    const grid = (gx: number, gy: number, cells: number, seed: number) =>
      hash(
        Math.imul(((gx % cells) + cells) % cells, 73856093) ^
          Math.imul(((gy % cells) + cells) % cells, 19349663) ^
          seed
      )
    const sample = (x: number, y: number, cells: number, seed: number) => {
      const xi = Math.floor(x)
      const yi = Math.floor(y)
      const u = smooth(x - xi)
      const v = smooth(y - yi)
      const a = grid(xi, yi, cells, seed)
      const b = grid(xi + 1, yi, cells, seed)
      const c = grid(xi, yi + 1, cells, seed)
      const d = grid(xi + 1, yi + 1, cells, seed)
      return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v
    }
    const out = new Float32Array(TEX * TEX)
    for (let y = 0; y < TEX; y++) {
      for (let x = 0; x < TEX; x++) {
        out[y * TEX + x] =
          0.66 * sample((x / TEX) * 16, (y / TEX) * 16, 16, 101) +
          0.34 * sample((x / TEX) * 48, (y / TEX) * 48, 48, 707)
      }
    }
    return out
  })()

  function parseColor(value: string): RGB | null {
    const m = value.trim().match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i)
    if (!m) return null
    const hex = m[1]
    if (hex.length === 3) {
      return [
        parseInt(hex[0] + hex[0], 16),
        parseInt(hex[1] + hex[1], 16),
        parseInt(hex[2] + hex[2], 16),
      ]
    }
    return [
      parseInt(hex.slice(0, 2), 16),
      parseInt(hex.slice(2, 4), 16),
      parseInt(hex.slice(4, 6), 16),
    ]
  }

  const mix = (a: RGB, b: RGB, t: number): RGB => [
    a[0] + (b[0] - a[0]) * t,
    a[1] + (b[1] - a[1]) * t,
    a[2] + (b[2] - a[2]) * t,
  ]

  // The duo-tone companion: the accent hue-rotated while preserving
  // saturation and lightness. Warm accents lean toward rust, cool ones
  // toward violet, so every theme gets a native pairing.
  function hueCompanion(c: RGB): RGB {
    const [r, g, b] = c.map(v => v / 255)
    const max = Math.max(r, g, b)
    const min = Math.min(r, g, b)
    const l = (max + min) / 2
    const d = max - min
    if (d === 0) return c
    const s = d / (1 - Math.abs(2 * l - 1))
    let h = 0
    if (max === r) h = ((g - b) / d) % 6
    else if (max === g) h = (b - r) / d + 2
    else h = (r - g) / d + 4
    h *= 60
    if (h < 0) h += 360
    h += h >= 15 && h <= 70 ? -45 : 45
    if (h >= 360) h -= 360
    if (h < 0) h += 360
    const c1 = (1 - Math.abs(2 * l - 1)) * s
    const x = c1 * (1 - Math.abs(((h / 60) % 2) - 1))
    const m = l - c1 / 2
    let rgb: RGB
    if (h < 60) rgb = [c1, x, 0]
    else if (h < 120) rgb = [x, c1, 0]
    else if (h < 180) rgb = [0, c1, x]
    else if (h < 240) rgb = [0, x, c1]
    else if (h < 300) rgb = [x, 0, c1]
    else rgb = [c1, 0, x]
    return [
      Math.round((rgb[0] + m) * 255),
      Math.round((rgb[1] + m) * 255),
      Math.round((rgb[2] + m) * 255),
    ]
  }

  function readPalette(): Palette {
    const cs = getComputedStyle(document.documentElement)
    const bg = parseColor(cs.getPropertyValue('--color-bg')) ?? [255, 255, 255]
    const ink = parseColor(cs.getPropertyValue('--color-accent')) ?? [16, 63, 234]
    const text = parseColor(cs.getPropertyValue('--color-text')) ?? [96, 108, 118]
    const lum = (0.2126 * bg[0] + 0.7152 * bg[1] + 0.0722 * bg[2]) / 255
    if (lum < 0.4) {
      // Dark grounds carry light: a faint duo-tone glow and near-white stars.
      return {
        bg,
        ink,
        ink2: hueCompanion(ink),
        // The bloom tone: near-white carrying a whisper of the accent.
        ink3: mix([255, 255, 255], ink, 0.15),
        star: mix(ink, [255, 255, 255], 0.45),
        coverage: 0.68,
        maxInk: 0.55,
      }
    }
    // Light grounds read as halftone ink pressed into paper.
    return {
      bg,
      ink,
      ink2: hueCompanion(ink),
      // On paper, blooms read as full-strength deep companion dots.
      ink3: mix(hueCompanion(ink), [0, 0, 0], 0.12),
      star: mix(text, ink, 0.3),
      coverage: 0.56,
      maxInk: 0.38,
    }
  }

  /*
   * Fluid wake, after the ObsidianUI dither-canvas solver: a fixed 80x60
   * Stam grid (diffuse, project, advect, project) stepped once per frame
   * at a fixed 16ms timestep, with velocities decaying toward calm. The
   * pointer feeds it through a short-lived trail of points; the packed
   * field is uploaded as bytes and sampled by the fragment shader to
   * warp the scene and light the wake.
   */
  const FC = 80
  const FR = 60
  const FN = FC * FR
  const FLUID_VMAX = 3
  const TRAIL_LIFE = 320
  const TRAIL_STEP = 10
  const TRAIL_MAX = 72
  const TRAIL_CFG = { fb: 0.08, fss: 18, ffm: 0.2, fir: 0.8, firl: 1.0 }

  interface Fluid {
    vx: Float32Array
    vy: Float32Array
    fi: (x: number, y: number) => number
    step: () => void
  }

  function createFluid(): Fluid {
    const vx = new Float32Array(FN)
    const vy = new Float32Array(FN)
    const vx0 = new Float32Array(FN)
    const vy0 = new Float32Array(FN)
    const p = new Float32Array(FN)
    const div = new Float32Array(FN)

    const fi = (x: number, y: number) =>
      Math.max(0, Math.min(FR - 1, y)) * FC + Math.max(0, Math.min(FC - 1, x))
    const bnd = (b: number, a: Float32Array) => {
      for (let x = 1; x < FC - 1; x++) {
        a[fi(x, 0)] = b === 2 ? -a[fi(x, 1)] : a[fi(x, 1)]
        a[fi(x, FR - 1)] = b === 2 ? -a[fi(x, FR - 2)] : a[fi(x, FR - 2)]
      }
      for (let y = 1; y < FR - 1; y++) {
        a[fi(0, y)] = b === 1 ? -a[fi(1, y)] : a[fi(1, y)]
        a[fi(FC - 1, y)] = b === 1 ? -a[fi(FC - 2, y)] : a[fi(FC - 2, y)]
      }
    }
    const diffuse = (b: number, d: Float32Array, s: Float32Array, diff: number, dt: number) => {
      const a = dt * diff * FN
      for (let k = 0; k < 4; k++) {
        for (let y = 1; y < FR - 1; y++)
          for (let x = 1; x < FC - 1; x++) {
            d[fi(x, y)] =
              (s[fi(x, y)] +
                a * (d[fi(x - 1, y)] + d[fi(x + 1, y)] + d[fi(x, y - 1)] + d[fi(x, y + 1)])) /
              (1 + 4 * a)
          }
        bnd(b, d)
      }
    }
    const advect = (
      b: number,
      d: Float32Array,
      d0: Float32Array,
      ux: Float32Array,
      uy: Float32Array,
      dt: number
    ) => {
      const dtx = dt * FC * 1.4
      const dty = dt * FR * 1.4
      for (let y = 1; y < FR - 1; y++)
        for (let x = 1; x < FC - 1; x++) {
          const px = Math.max(0.5, Math.min(FC - 1.5, x - dtx * ux[fi(x, y)]))
          const py = Math.max(0.5, Math.min(FR - 1.5, y - dty * uy[fi(x, y)]))
          const x0 = Math.floor(px)
          const y0 = Math.floor(py)
          const s1 = px - x0
          const s0 = 1 - s1
          const t1 = py - y0
          const t0 = 1 - t1
          d[fi(x, y)] =
            s0 * (t0 * d0[fi(x0, y0)] + t1 * d0[fi(x0, y0 + 1)]) +
            s1 * (t0 * d0[fi(x0 + 1, y0)] + t1 * d0[fi(x0 + 1, y0 + 1)])
        }
      bnd(b, d)
    }
    const project = (ux: Float32Array, uy: Float32Array) => {
      const hx = 1 / FC
      const hy = 1 / FR
      for (let y = 1; y < FR - 1; y++)
        for (let x = 1; x < FC - 1; x++) {
          div[fi(x, y)] =
            -0.5 *
            (hx * (ux[fi(x + 1, y)] - ux[fi(x - 1, y)]) +
              hy * (uy[fi(x, y + 1)] - uy[fi(x, y - 1)]))
          p[fi(x, y)] = 0
        }
      bnd(0, div)
      bnd(0, p)
      for (let k = 0; k < 4; k++) {
        for (let y = 1; y < FR - 1; y++)
          for (let x = 1; x < FC - 1; x++) {
            p[fi(x, y)] =
              (div[fi(x, y)] +
                p[fi(x - 1, y)] +
                p[fi(x + 1, y)] +
                p[fi(x, y - 1)] +
                p[fi(x, y + 1)]) /
              4
          }
        bnd(0, p)
      }
      for (let y = 1; y < FR - 1; y++)
        for (let x = 1; x < FC - 1; x++) {
          ux[fi(x, y)] -= (0.5 * (p[fi(x + 1, y)] - p[fi(x - 1, y)])) / hx
          uy[fi(x, y)] -= (0.5 * (p[fi(x, y + 1)] - p[fi(x, y - 1)])) / hy
        }
      bnd(1, ux)
      bnd(2, uy)
    }
    return {
      vx,
      vy,
      fi,
      step() {
        diffuse(1, vx0, vx, 0.00002, 0.016)
        diffuse(2, vy0, vy, 0.00002, 0.016)
        project(vx0, vy0)
        advect(1, vx, vx0, vx0, vy0, 0.016)
        advect(2, vy, vy0, vx0, vy0, 0.016)
        project(vx, vy)
        for (let i = 0; i < FN; i++) {
          vx[i] *= 0.94
          vy[i] *= 0.94
        }
      },
    }
  }

  const VERT = `
    attribute vec2 a_pos;
    void main() {
      gl_Position = vec4(a_pos, 0.0, 1.0);
    }
  `

  // All geometry is normalised by the buffer height so mediump fragment
  // shaders stay far from overflow territory. Content (arc, noise, stars)
  // is sampled through the fluid warp; the dither lattice stays fixed to
  // the framebuffer, so dots hold still while the sky flows beneath them.
  const FRAG = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif
    uniform vec2 u_res;
    uniform float u_time;
    uniform vec3 u_bg;
    uniform vec3 u_ink;
    uniform vec3 u_ink2;
    uniform vec3 u_ink3;
    uniform vec3 u_star;
    uniform float u_coverage;
    uniform float u_maxInk;
    uniform sampler2D u_noise;
    uniform sampler2D u_bayer;
    uniform sampler2D u_fluid;
    uniform vec4 u_tp[${TRAIL_MAX}];
    uniform float u_tl[${TRAIL_MAX}];
    uniform float u_boil;

    float h21(vec2 p) {
      return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
    }

    void main() {
      vec2 px = vec2(gl_FragCoord.x, u_res.y - gl_FragCoord.y);
      float aspect = u_res.x / u_res.y;
      // Scene constants are tuned for a 240px-tall half-resolution buffer.
      float us = u_res.y / 240.0;

      // Coarse velocity field from the CPU solver, velocity packed into
      // the RG bytes of an ${FC}x${FR} texture.
      vec2 fluidUV = (floor(vec2(px.x / u_res.x, px.y / u_res.y) * vec2(${FC}.0, ${FR}.0)) + 0.5) / vec2(${FC}.0, ${FR}.0);
      vec2 fl = (texture2D(u_fluid, fluidUV).rg * 2.0 - 1.0) * ${FLUID_VMAX}.0;
      float hm = min(1.0, length(fl) * 1.1);

      // Recent pointer points push the scene away and drag it along.
      vec2 disp = vec2(0.0);
      for (int i = 0; i < ${TRAIL_MAX}; i++) {
        float life = u_tl[i];
        if (life > 0.0) {
          vec2 d = px - u_tp[i].xy;
          float dist = length(d);
          float r = (5.0 + life * 3.0) * us;
          if (dist > 0.0 && dist < r) {
            float f = pow(1.0 - dist / r, 2.0);
            disp += (d / dist) * f * life * 3.0 * us + u_tp[i].zw * f * 0.04 * us;
          }
        }
      }

      vec2 spx = px + disp + fl * 11.0 * us;
      vec2 p = spx / u_res.y;

      // A cloud trail: bright head near the top-right, bowing as it
      // descends toward the lower-left and dispersing into dither smoke
      // before it reaches the lockup text.
      vec2 c = vec2(aspect * (0.82 + 0.02 * sin(u_time * 0.05)), 1.06);
      float dx = p.x - c.x;
      float dy = p.y - c.y;
      float ang = atan(dy, dx);
      // Trail coordinate: 0 at the arc's peak (the head), growing along the
      // tail; the short side past the head fades fast.
      float s = ang < -1.5708 ? (-1.5708 - ang) / 1.2 : (ang + 1.5708) * 2.5;
      float trail = 0.25 + 0.75 * exp(-s * 1.05);
      // The band undulates like a jet stream, the wave drifting slowly
      // along its length.
      float d = sqrt(dx * dx + dy * dy) - 0.95
        + 0.032 * sin(ang * 6.0 + u_time * 0.11)
        + 0.018 * sin(ang * 2.0 - u_time * 0.05);
      float m = (0.58 + 0.42 * (0.5 + 0.5
        * sin(3.0 * ang + u_time * 0.055)
        * sin(2.0 * ang + 1.3 - u_time * 0.034))) * trail;
      // Thicker at the head, thinning to smoke along the tail.
      float bandW = 0.052 * (1.0 + 0.4 * trail);
      float q = d / bandW;
      float band = exp(-q * q) * 1.05 * m;
      float hq = d / 0.36;
      float halo = exp(-hq * hq) * (0.33 + 0.12 * (1.0 - trail)) * m;
      float sky = 0.2 * exp(-(p.y * p.y) / 0.36);
      float tex = 0.55 + 0.75 * texture2D(
        u_noise, (spx + vec2(u_time * 1.3, -u_time * 0.9)) / 128.0).r;
      float cBand = band * tex * u_coverage;
      float cOuter = (halo + sky) * tex * u_coverage;

      // The wake adds coverage, and where it runs the dither density
      // boils: the threshold breathes with the phase clock, mottled by
      // the same drifting noise as the sky so lit dots cluster
      // organically instead of in lattice rows.
      float th = texture2D(u_bayer, gl_FragCoord.xy / 8.0).r + u_boil * min(1.0, hm * 1.4) * tex;
      // The wake lifts coverage most in sparse sky; where the field is
      // already dense it deepens existing dots instead of adding new
      // ones, and the lift is ceilinged so a lattice of unlit dots
      // always survives — the dither never saturates to solid.
      float cov = clamp(cBand + cOuter, 0.0, 1.0);
      float lift = min(hm * 0.55 * (1.0 - 0.7 * cov), max(0.0, 0.88 - cov));
      float deepen = hm * 0.35 * cov;
      vec3 col = u_bg;
      if (cBand + lift > th) {
        col = u_bg + (u_ink - u_bg) * min(u_maxInk + deepen, 0.3 + (cBand + lift) * 1.1);
      } else if (cOuter + lift > th) {
        col = u_bg + (u_ink2 - u_bg) * min(u_maxInk + deepen, 0.3 + (cOuter + lift) * 1.1) * 0.8;
      } else if (hm > 0.04 && th < cov + hm * 0.45 * tex) {
        // Ground dots surface inside the wake, lit from beneath.
        col = u_bg + (u_ink3 - u_bg) * min(u_maxInk + 0.2, 0.15 + hm * 0.65);
      }
      // Everything in the flow leans toward the bloom tone.
      col = mix(col, u_ink3, hm * 0.5 * (1.0 - 0.4 * cov));

      // Ephemeral blooming stars: a handful of slots, each appearing at a
      // random spot in the sky, swelling from a pixel into a small dithered
      // disc, then dissolving.
      float bloom = 0.0;
      for (int i = 0; i < 7; i++) {
        float fi = float(i);
        float period = 9.0 + h21(vec2(fi, 3.7)) * 7.0;
        float phase = fi * 0.618;
        float life = fract(u_time / period + phase);
        float cycle = floor(u_time / period + phase);
        vec2 seed = vec2(fi * 17.13 + cycle * 7.31, fi * 3.77 + cycle * 11.7);
        vec2 center = vec2(h21(seed), h21(seed + vec2(5.5, 9.2)))
          * vec2(u_res.x, u_res.y * 0.8);
        vec2 bsp = spx - center;
        float dist2 = dot(bsp, bsp);
        float radius = 1.5 + 3.5 * life;
        if (dist2 < radius * radius) {
          float cov = 1.0 - sqrt(dist2) / radius;
          float alpha = pow(sin(3.14159 * life), 1.5);
          bloom = max(bloom, cov * alpha * 0.9);
        }
      }
      if (bloom > th) {
        col = u_bg + (u_ink3 - u_bg) * min(1.0, 0.4 + bloom);
      }

      // Sparse deterministic starfield with slow twinkle.
      vec2 cell = floor(spx / 22.0);
      float r1 = h21(cell);
      if (r1 < 0.055) {
        vec2 spos = vec2(h21(cell + 1.7), h21(cell + 3.3)) * 22.0;
        if (floor(spx) == floor(spos)) {
          float b = 0.22 + 0.5 * h21(cell + 5.1);
          float tw = h21(cell + 7.7);
          float gate = mix(1.0,
            0.5 + 0.5 * sin(u_time * (0.25 + tw) + r1 * 37.0),
            step(tw, 0.35));
          vec3 scol = h21(cell + 11.3) < 0.16 ? u_ink : u_star;
          col = col + (scol - col) * clamp(b * gate, 0.0, 1.0);
        }
      }
      gl_FragColor = vec4(col, 1.0);
    }
  `

  const root = document.querySelector<HTMLElement>('.dither-sky')
  const canvas = document.querySelector<HTMLCanvasElement>('.dither-sky-canvas')

  if (root && canvas) {
    const gl = canvas.getContext('webgl', {
      alpha: false,
      antialias: false,
      depth: false,
      stencil: false,
      // Keeps the framebuffer readable for the __dithersky diagnostics;
      // the buffer is half-resolution, so the extra copy is negligible.
      preserveDrawingBuffer: true,
    })
    let palette = readPalette()
    // Start mid-cycle so the first (possibly only) frame is a composed one.
    let elapsed = 12.6

    const drawStatic = () => {
      // CPU fallback: one composed frame, no loop.
      const ctx = canvas.getContext('2d')
      if (!ctx) {
        // WebGL context exists but the program failed to build: settle for
        // clean ground rather than a blank canvas.
        if (gl) {
          const [r, g, b] = palette.bg
          gl.viewport(0, 0, canvas.width, canvas.height)
          gl.clearColor(r / 255, g / 255, b / 255, 1)
          gl.clear(gl.COLOR_BUFFER_BIT)
        }
        return
      }
      const rect = canvas.getBoundingClientRect()
      const vw = Math.max(320, rect.width || window.innerWidth)
      const vh = Math.max(240, rect.height || window.innerHeight)
      const scale = Math.max(1, Math.sqrt((vw * vh) / 4 / 1_300_000))
      const W = Math.max(160, Math.round(vw / 2 / scale))
      const H = Math.max(120, Math.round(vh / 2 / scale))
      canvas.width = W
      canvas.height = H
      const image = ctx.createImageData(W, H)
      const d = image.data
      const { bg, ink, ink2, ink3, star, coverage, maxInk } = palette
      const cx = W * (0.82 + 0.02 * Math.sin(elapsed * 0.05))
      const cy = H * 1.06
      const R = H * 0.95
      const phaseA = elapsed * 0.055
      const phaseB = 1.3 - elapsed * 0.034
      const wave1 = elapsed * 0.11
      const wave2 = -elapsed * 0.05
      const texX = Math.floor(elapsed * 1.3)
      const texY = Math.floor(elapsed * -0.9)
      for (let y = 0; y < H; y++) {
        const dy = y - cy
        const sky = 0.2 * Math.exp(-((y / (H * 0.6)) ** 2))
        for (let x = 0; x < W; x++) {
          const dx = x - cx
          const dSq = dx * dx + dy * dy
          let band = 0
          let halo = 0
          if (dSq > (R - H * 0.55) ** 2 && dSq < (R + H * 0.55) ** 2) {
            const ang = Math.atan2(dy, dx)
            const s = ang < -1.5708 ? (-1.5708 - ang) / 1.2 : (ang + 1.5708) * 2.5
            const trail = 0.25 + 0.75 * Math.exp(-s * 1.05)
            const dist =
              Math.sqrt(dSq) -
              R +
              H * (0.032 * Math.sin(6 * ang + wave1) + 0.018 * Math.sin(2 * ang + wave2))
            const mod =
              (0.58 +
                0.42 * (0.5 + 0.5 * Math.sin(3 * ang + phaseA) * Math.sin(2 * ang + phaseB))) *
              trail
            const bandW = H * 0.052 * (1 + 0.4 * trail)
            const q = dist / bandW
            band = Math.exp(-q * q) * 1.05 * mod
            const hq = dist / (H * 0.36)
            halo = Math.exp(-hq * hq) * (0.33 + 0.12 * (1 - trail)) * mod
          }
          const tex = 0.55 + 0.75 * noise[((y + texY) & 127) * 128 + ((x + texX) & 127)]
          const cBand = band * tex * coverage
          const cOuter = (halo + sky) * tex * coverage
          const o = (y * W + x) * 4
          let color: RGB | null = null
          let k = 0
          if (cBand > bayer[(y & 7) * 8 + (x & 7)]) {
            color = ink
            k = Math.min(maxInk, 0.3 + cBand * 1.1)
          } else if (cOuter > bayer[(y & 7) * 8 + (x & 7)]) {
            color = ink2
            k = Math.min(maxInk, 0.3 + cOuter * 1.1) * 0.8
          }
          if (color) {
            d[o] = bg[0] + (color[0] - bg[0]) * k
            d[o + 1] = bg[1] + (color[1] - bg[1]) * k
            d[o + 2] = bg[2] + (color[2] - bg[2]) * k
          } else {
            d[o] = bg[0]
            d[o + 1] = bg[1]
            d[o + 2] = bg[2]
          }
          d[o + 3] = 255
        }
      }
      const cellsX = Math.ceil(W / 22)
      const cellsY = Math.ceil(H / 22)
      for (let sy = 0; sy < cellsY; sy++) {
        for (let sx = 0; sx < cellsX; sx++) {
          const id = Math.imul(sx, 668265263) ^ Math.imul(sy, 374761393)
          const r = hash(id)
          if (r > 0.055) continue
          const px = sx * 22 + Math.floor(hash(id ^ 0x9e3779b9) * 22)
          const py = sy * 22 + Math.floor(hash(id ^ 0x85ebca6b) * 22)
          if (px >= W || py >= H) continue
          let brightness = 0.22 + 0.5 * hash(id ^ 0xc2b2ae35)
          const twinkleSeed = hash(id ^ 0x27d4eb2f)
          if (twinkleSeed < 0.35) {
            brightness *= 0.5 + 0.5 * Math.sin(elapsed * (0.25 + twinkleSeed) + r * 37)
          }
          const color = hash(id ^ 0x165667b1) < 0.16 ? ink : star
          const i = (py * W + px) * 4
          d[i] += (color[0] - d[i]) * brightness
          d[i + 1] += (color[1] - d[i + 1]) * brightness
          d[i + 2] += (color[2] - d[i + 2]) * brightness
        }
      }
      // Ephemeral blooming stars (third tone), matching the shader pass.
      for (let slot = 0; slot < 7; slot++) {
        const period = 9 + hash(slot * 71 + 13) * 7
        const phase = slot * 0.618
        const life = (((elapsed / period + phase) % 1) + 1) % 1
        const cycle = Math.floor(elapsed / period + phase)
        const cx = Math.floor(hash(slot * 1713 + cycle * 731) * W)
        const cy = Math.floor(hash(slot * 377 + cycle * 1170) * H * 0.8)
        const radius = 1.5 + 3.5 * life
        const alpha = Math.sin(Math.PI * life) ** 1.5
        for (let y = Math.floor(cy - radius); y <= Math.ceil(cy + radius); y++) {
          if (y < 0 || y >= H) continue
          for (let x = Math.floor(cx - radius); x <= Math.ceil(cx + radius); x++) {
            if (x < 0 || x >= W) continue
            const dist = Math.hypot(x - cx, y - cy)
            if (dist > radius) continue
            const cov = (1 - dist / radius) * alpha * 0.9
            if (cov <= bayer[(y & 7) * 8 + (x & 7)]) continue
            const k = Math.min(1, 0.4 + cov)
            const i = (y * W + x) * 4
            d[i] = bg[0] + (ink3[0] - bg[0]) * k
            d[i + 1] = bg[1] + (ink3[1] - bg[1]) * k
            d[i + 2] = bg[2] + (ink3[2] - bg[2]) * k
          }
        }
      }
      ctx.putImageData(image, 0, 0)
    }

    // Pointer trail, in buffer pixels: birth timestamps age out in
    // TRAIL_LIFE ms; each point remembers the velocity that spawned it.
    interface TrailPoint {
      x: number
      y: number
      vx: number
      vy: number
      b: number
    }

    const fluid = createFluid()
    const fluidData = new Uint8Array(FN * 4)
    const trail: TrailPoint[] = []
    const tpBuf = new Float32Array(TRAIL_MAX * 4)
    const tlBuf = new Float32Array(TRAIL_MAX)
    let phase = 0
    let frameCount = 0
    let bufferPerCss = 1

    const buildRenderer = () => {
      if (!gl) return null
      const compile = (type: number, src: string) => {
        const sh = gl.createShader(type)
        if (!sh) return null
        gl.shaderSource(sh, src)
        gl.compileShader(sh)
        if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) return null
        return sh
      }
      const vs = compile(gl.VERTEX_SHADER, VERT)
      const fs = compile(gl.FRAGMENT_SHADER, FRAG)
      if (!vs || !fs) return null
      const program = gl.createProgram()
      if (!program) return null
      gl.attachShader(program, vs)
      gl.attachShader(program, fs)
      gl.linkProgram(program)
      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return null
      gl.useProgram(program)

      const quad = gl.createBuffer()
      gl.bindBuffer(gl.ARRAY_BUFFER, quad)
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW)
      const loc = gl.getAttribLocation(program, 'a_pos')
      gl.enableVertexAttribArray(loc)
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0)

      const makeTexture = (data: Uint8Array, size: number, filter: number) => {
        const tex = gl.createTexture()
        if (!tex) return null
        gl.bindTexture(gl.TEXTURE_2D, tex)
        gl.texImage2D(
          gl.TEXTURE_2D,
          0,
          gl.LUMINANCE,
          size,
          size,
          0,
          gl.LUMINANCE,
          gl.UNSIGNED_BYTE,
          data
        )
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.REPEAT)
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.REPEAT)
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, filter)
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, filter)
        return tex
      }

      const noiseTex = makeTexture(
        new Uint8Array(noise.map(v => Math.round(v * 255))),
        TEX,
        gl.LINEAR
      )
      const bayerTex = makeTexture(
        new Uint8Array(bayer.map(v => Math.round(v * 255))),
        8,
        gl.NEAREST
      )
      if (!noiseTex || !bayerTex) return null

      // Velocity field texture: vx/vy packed into RG bytes around 128.
      const fluidTex = gl.createTexture()
      if (!fluidTex) return null
      gl.activeTexture(gl.TEXTURE2)
      gl.bindTexture(gl.TEXTURE_2D, fluidTex)
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, FC, FR, 0, gl.RGBA, gl.UNSIGNED_BYTE, fluidData)
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE)
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE)
      // Bilinear so the coarse grid interpolates smoothly: no cell-sized
      // steps in the wake's edges or displacement.
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR)
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR)

      const u = (name: string) => gl.getUniformLocation(program, name)
      const uniforms = {
        res: u('u_res'),
        time: u('u_time'),
        bg: u('u_bg'),
        ink: u('u_ink'),
        ink2: u('u_ink2'),
        ink3: u('u_ink3'),
        star: u('u_star'),
        coverage: u('u_coverage'),
        maxInk: u('u_maxInk'),
        noise: u('u_noise'),
        bayer: u('u_bayer'),
        fluid: u('u_fluid'),
        tp: u('u_tp'),
        tl: u('u_tl'),
        boil: u('u_boil'),
      }
      gl.uniform1i(uniforms.noise, 0)
      gl.uniform1i(uniforms.bayer, 1)
      gl.uniform1i(uniforms.fluid, 2)
      gl.activeTexture(gl.TEXTURE0)
      gl.bindTexture(gl.TEXTURE_2D, noiseTex)
      gl.activeTexture(gl.TEXTURE1)
      gl.bindTexture(gl.TEXTURE_2D, bayerTex)

      const draw = (t: number) => {
        gl.viewport(0, 0, canvas.width, canvas.height)
        gl.uniform2f(uniforms.res, canvas.width, canvas.height)
        gl.uniform1f(uniforms.time, t)
        gl.uniform3f(uniforms.bg, palette.bg[0] / 255, palette.bg[1] / 255, palette.bg[2] / 255)
        gl.uniform3f(uniforms.ink, palette.ink[0] / 255, palette.ink[1] / 255, palette.ink[2] / 255)
        gl.uniform3f(
          uniforms.ink2,
          palette.ink2[0] / 255,
          palette.ink2[1] / 255,
          palette.ink2[2] / 255
        )
        gl.uniform3f(
          uniforms.ink3,
          palette.ink3[0] / 255,
          palette.ink3[1] / 255,
          palette.ink3[2] / 255
        )
        gl.uniform3f(
          uniforms.star,
          palette.star[0] / 255,
          palette.star[1] / 255,
          palette.star[2] / 255
        )
        gl.uniform1f(uniforms.coverage, palette.coverage)
        gl.uniform1f(uniforms.maxInk, palette.maxInk)

        gl.activeTexture(gl.TEXTURE2)
        gl.bindTexture(gl.TEXTURE_2D, fluidTex)
        for (let i = 0; i < FN; i++) {
          fluidData[i * 4] = Math.max(
            0,
            Math.min(255, Math.round(128 + (fluid.vx[i] * 127) / FLUID_VMAX))
          )
          fluidData[i * 4 + 1] = Math.max(
            0,
            Math.min(255, Math.round(128 + (fluid.vy[i] * 127) / FLUID_VMAX))
          )
          fluidData[i * 4 + 3] = 255
        }
        gl.texSubImage2D(gl.TEXTURE_2D, 0, 0, 0, FC, FR, gl.RGBA, gl.UNSIGNED_BYTE, fluidData)

        tpBuf.fill(0)
        tlBuf.fill(0)
        for (let i = 0; i < trail.length && i < TRAIL_MAX; i++) {
          const pt = trail[i]
          tpBuf[i * 4] = pt.x
          tpBuf[i * 4 + 1] = pt.y
          tpBuf[i * 4 + 2] = pt.vx
          tpBuf[i * 4 + 3] = pt.vy
          tlBuf[i] = Math.max(0, 1 - (performance.now() - pt.b) / TRAIL_LIFE)
        }
        gl.uniform4fv(uniforms.tp, tpBuf)
        gl.uniform1fv(uniforms.tl, tlBuf)
        gl.uniform1f(uniforms.boil, Math.sin(phase * 1.2566) * 0.18)

        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4)
      }

      return { draw }
    }

    const renderer = buildRenderer()

    // Tiny diagnostic hook (mirrors stencil.so's own): reports the active
    // renderer and measured frames per second.
    const diagnostics = {
      mode: renderer ? 'webgl' : 'cpu-static',
      fps: 0,
      time: elapsed,
      size: () => [canvas.width, canvas.height],
      trail: () => trail.length,
      flowMax: () => {
        let m = 0
        for (let i = 0; i < FN; i++) m = Math.max(m, Math.hypot(fluid.vx[i], fluid.vy[i]))
        return Math.round(m * 1000) / 1000
      },
    }
    ;(window as unknown as Record<string, unknown>).__dithersky = diagnostics
    let fpsFrames = 0
    let fpsAt = performance.now()

    const resize = () => {
      const rect = canvas.getBoundingClientRect()
      const vw = Math.max(320, rect.width || window.innerWidth)
      const vh = Math.max(240, rect.height || window.innerHeight)
      const scale = Math.max(1, Math.sqrt((vw * vh) / 4 / 1_300_000))
      canvas.width = Math.max(160, Math.round(vw / 2 / scale))
      canvas.height = Math.max(120, Math.round(vh / 2 / scale))
      bufferPerCss = canvas.width / vw
      draw(elapsed)
    }

    const draw = (t: number) => {
      if (renderer) renderer.draw(t)
      else drawStatic()
    }

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
    let raf = 0
    let last = 0

    // Age out trail points and push their momentum into the fluid grid.
    const injectTrail = (ts: number) => {
      for (let i = trail.length - 1; i >= 0; i--) {
        const pt = trail[i]
        const age = ts - pt.b
        if (age >= TRAIL_LIFE) {
          trail.splice(i, 1)
          continue
        }
        const life = 1 - age / TRAIL_LIFE
        const radius = TRAIL_CFG.fir + life * TRAIL_CFG.firl
        const gr = Math.ceil(radius)
        const speed = Math.hypot(pt.vx, pt.vy)
        const force = (TRAIL_CFG.fb + Math.min(speed, TRAIL_CFG.fss) / TRAIL_CFG.fss) * life
        const cx = Math.max(0, Math.min(FC - 1, ((pt.x / canvas.width) * FC) | 0))
        const cy = Math.max(0, Math.min(FR - 1, ((pt.y / canvas.height) * FR) | 0))
        for (let dy = -gr; dy <= gr; dy++)
          for (let dx = -gr; dx <= gr; dx++) {
            const dist = Math.hypot(dx, dy)
            if (dist > radius) continue
            const f = (1 - dist / radius) ** 2
            fluid.vx[fluid.fi(cx + dx, cy + dy)] += pt.vx * f * force * TRAIL_CFG.ffm
            fluid.vy[fluid.fi(cx + dx, cy + dy)] += pt.vy * f * force * TRAIL_CFG.ffm
          }
      }
    }

    const tick = (now: number) => {
      raf = requestAnimationFrame(tick)
      const dt = now - last
      if (dt <= 0) return
      elapsed += Math.min(dt, 250) / 1000
      last = now
      injectTrail(now)
      fluid.step()
      if (frameCount++ % 8 === 0) phase = (phase + 1) % 16
      draw(elapsed)
      fpsFrames++
      diagnostics.time = elapsed
      if (now - fpsAt >= 1000) {
        diagnostics.fps = Math.round((fpsFrames * 1000) / (now - fpsAt))
        fpsFrames = 0
        fpsAt = now
      }
    }

    const setMotion = () => {
      cancelAnimationFrame(raf)
      if (motionQuery.matches || !renderer) {
        trail.length = 0
        draw(elapsed)
      } else {
        last = performance.now()
        raf = requestAnimationFrame(tick)
      }
    }

    // Pointer movement anywhere on the page feeds the wake: the canvas
    // sits behind everything, so the whole document is the interaction
    // surface. Points land every TRAIL_STEP buffer pixels of travel.
    const mouse = { x: -9999, y: -9999, vx: 0, vy: 0 }
    const onMove = (event: PointerEvent) => {
      if (motionQuery.matches) return
      const mx = event.clientX * bufferPerCss
      const my = event.clientY * bufferPerCss
      const px = mouse.x
      const py = mouse.y
      mouse.x = mx
      mouse.y = my
      mouse.vx = mx - px
      mouse.vy = my - py
      if (px < 0 || py < 0) {
        trail.unshift({ x: mx, y: my, vx: 0, vy: 0, b: performance.now() })
        if (trail.length > TRAIL_MAX) trail.length = TRAIL_MAX
        return
      }
      const d = Math.hypot(mouse.vx, mouse.vy)
      if (d < 0.5) return
      const steps = Math.max(1, Math.ceil(d / TRAIL_STEP))
      const birth = performance.now()
      for (let s = 1; s <= steps; s++) {
        const t = s / steps
        trail.unshift({
          x: px + mouse.vx * t,
          y: py + mouse.vy * t,
          vx: mouse.vx / steps,
          vy: mouse.vy / steps,
          b: birth,
        })
        if (trail.length > TRAIL_MAX) trail.length = TRAIL_MAX
      }
    }
    window.addEventListener('pointermove', onMove, { passive: true })
    document.documentElement.addEventListener('mouseleave', () => {
      mouse.x = -9999
      mouse.y = -9999
    })

    // Freeze on context loss: the last composed frame stays up rather
    // than flashing to blank; the loop stops burning the GPU.
    canvas.addEventListener('webglcontextlost', event => {
      event.preventDefault()
      cancelAnimationFrame(raf)
      diagnostics.mode = 'webgl-frozen'
    })

    const themeObserver = new MutationObserver(() => {
      palette = readPalette()
      draw(elapsed)
    })

    resize()
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    })
    const resizeObserver = new ResizeObserver(() => {
      resize()
    })
    resizeObserver.observe(root)
    motionQuery.addEventListener('change', setMotion)

    // Reveal once the first frame is on the canvas.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        root.classList.add('is-live')
      })
    })

    setMotion()

    window.addEventListener(
      'pagehide',
      () => {
        cancelAnimationFrame(raf)
        themeObserver.disconnect()
        resizeObserver.disconnect()
        window.removeEventListener('pointermove', onMove)
      },
      { once: true }
    )
  }
</script>
