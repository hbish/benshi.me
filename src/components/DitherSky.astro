---
// DitherSky: full-viewport ordered-dither field behind the landing page.
// One soft luminous arc in a duo-tone of the theme accent, a sparse
// starfield, and a slowly drifting noise field, quantised through an 8x8
// Bayer matrix. Rendered on the GPU at display refresh rate; a CPU path
// paints a single static frame when WebGL is unavailable.
---

<div class="dither-sky" aria-hidden="true">
  <canvas class="dither-sky-canvas"></canvas>
</div>

<style>
  .dither-sky {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    contain: strict;
    /*
     * The slanted field occupies roughly the upper-right two-thirds and
     * melts along a diagonal parallel to the arc, so it never reaches the
     * lower-left corner where the lockup text lives.
     */
    -webkit-mask-image: linear-gradient(225deg, #000 0%, #000 32%, transparent 68%);
    mask-image: linear-gradient(225deg, #000 0%, #000 32%, transparent 68%);
  }

  @media (max-aspect-ratio: 3 / 4) {
    .dither-sky {
      /* Portrait: the lockup spans most of the width, so flatten the dissolve. */
      -webkit-mask-image: linear-gradient(205deg, #000 0%, #000 30%, transparent 56%);
      mask-image: linear-gradient(205deg, #000 0%, #000 30%, transparent 56%);
    }
  }

  .dither-sky-canvas {
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    opacity: 0;
    transition: opacity 1.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dither-sky.is-live .dither-sky-canvas {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .dither-sky-canvas {
      transition: none;
    }
  }
</style>

<script>
  type RGB = [number, number, number]

  interface Palette {
    bg: RGB
    ink: RGB
    ink2: RGB
    star: RGB
    coverage: number
    maxInk: number
  }

  // 8x8 Bayer ordered-dither thresholds, normalised to (0, 1).
  const bayer = (() => {
    let matrix: number[][] = [
      [0, 2],
      [3, 1],
    ]
    for (let step = 0; step < 2; step++) {
      const size = matrix.length
      const next: number[][] = Array.from({ length: size * 2 }, () =>
        new Array<number>(size * 2).fill(0)
      )
      for (let y = 0; y < size; y++) {
        for (let x = 0; x < size; x++) {
          const base = 4 * matrix[y][x]
          next[y][x] = base
          next[y][x + size] = base + 2
          next[y + size][x] = base + 3
          next[y + size][x + size] = base + 1
        }
      }
      matrix = next
    }
    return matrix.flat().map(v => (v + 0.5) / 64)
  })()

  function hash(n: number): number {
    let t = n >>> 0
    t = Math.imul(t ^ (t >>> 16), 2246822519)
    t = Math.imul(t ^ (t >>> 13), 3266489917)
    t ^= t >>> 16
    return (t >>> 0) / 4294967296
  }

  // Tileable two-octave value noise, uploaded as a texture for the GPU and
  // sampled directly in the CPU fallback.
  const TEX = 128
  const noise = (() => {
    const smooth = (x: number) => x * x * (3 - 2 * x)
    const grid = (gx: number, gy: number, cells: number, seed: number) =>
      hash(
        Math.imul(((gx % cells) + cells) % cells, 73856093) ^
          Math.imul(((gy % cells) + cells) % cells, 19349663) ^
          seed
      )
    const sample = (x: number, y: number, cells: number, seed: number) => {
      const xi = Math.floor(x)
      const yi = Math.floor(y)
      const u = smooth(x - xi)
      const v = smooth(y - yi)
      const a = grid(xi, yi, cells, seed)
      const b = grid(xi + 1, yi, cells, seed)
      const c = grid(xi, yi + 1, cells, seed)
      const d = grid(xi + 1, yi + 1, cells, seed)
      return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v
    }
    const out = new Float32Array(TEX * TEX)
    for (let y = 0; y < TEX; y++) {
      for (let x = 0; x < TEX; x++) {
        out[y * TEX + x] =
          0.66 * sample((x / TEX) * 16, (y / TEX) * 16, 16, 101) +
          0.34 * sample((x / TEX) * 48, (y / TEX) * 48, 48, 707)
      }
    }
    return out
  })()

  function parseColor(value: string): RGB | null {
    const m = value.trim().match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i)
    if (!m) return null
    const hex = m[1]
    if (hex.length === 3) {
      return [
        parseInt(hex[0] + hex[0], 16),
        parseInt(hex[1] + hex[1], 16),
        parseInt(hex[2] + hex[2], 16),
      ]
    }
    return [
      parseInt(hex.slice(0, 2), 16),
      parseInt(hex.slice(2, 4), 16),
      parseInt(hex.slice(4, 6), 16),
    ]
  }

  const mix = (a: RGB, b: RGB, t: number): RGB => [
    a[0] + (b[0] - a[0]) * t,
    a[1] + (b[1] - a[1]) * t,
    a[2] + (b[2] - a[2]) * t,
  ]

  // The duo-tone companion: the accent hue-rotated while preserving
  // saturation and lightness. Warm accents lean toward rust, cool ones
  // toward violet, so every theme gets a native pairing.
  function hueCompanion(c: RGB): RGB {
    const [r, g, b] = c.map(v => v / 255)
    const max = Math.max(r, g, b)
    const min = Math.min(r, g, b)
    const l = (max + min) / 2
    const d = max - min
    if (d === 0) return c
    const s = d / (1 - Math.abs(2 * l - 1))
    let h = 0
    if (max === r) h = ((g - b) / d) % 6
    else if (max === g) h = (b - r) / d + 2
    else h = (r - g) / d + 4
    h *= 60
    if (h < 0) h += 360
    h += h >= 15 && h <= 70 ? -45 : 45
    if (h >= 360) h -= 360
    if (h < 0) h += 360
    const c1 = (1 - Math.abs(2 * l - 1)) * s
    const x = c1 * (1 - Math.abs(((h / 60) % 2) - 1))
    const m = l - c1 / 2
    let rgb: RGB
    if (h < 60) rgb = [c1, x, 0]
    else if (h < 120) rgb = [x, c1, 0]
    else if (h < 180) rgb = [0, c1, x]
    else if (h < 240) rgb = [0, x, c1]
    else if (h < 300) rgb = [x, 0, c1]
    else rgb = [c1, 0, x]
    return [
      Math.round((rgb[0] + m) * 255),
      Math.round((rgb[1] + m) * 255),
      Math.round((rgb[2] + m) * 255),
    ]
  }

  function readPalette(): Palette {
    const cs = getComputedStyle(document.documentElement)
    const bg = parseColor(cs.getPropertyValue('--color-bg')) ?? [255, 255, 255]
    const ink = parseColor(cs.getPropertyValue('--color-accent')) ?? [16, 63, 234]
    const text = parseColor(cs.getPropertyValue('--color-text')) ?? [96, 108, 118]
    const lum = (0.2126 * bg[0] + 0.7152 * bg[1] + 0.0722 * bg[2]) / 255
    if (lum < 0.4) {
      // Dark grounds carry light: a faint duo-tone glow and near-white stars.
      return {
        bg,
        ink,
        ink2: hueCompanion(ink),
        star: mix(ink, [255, 255, 255], 0.45),
        coverage: 0.68,
        maxInk: 0.55,
      }
    }
    // Light grounds read as halftone ink pressed into paper.
    return {
      bg,
      ink,
      ink2: hueCompanion(ink),
      star: mix(text, ink, 0.3),
      coverage: 0.56,
      maxInk: 0.38,
    }
  }

  const VERT = `
    attribute vec2 a_pos;
    void main() {
      gl_Position = vec4(a_pos, 0.0, 1.0);
    }
  `

  // All geometry is normalised by the buffer height so mediump fragment
  // shaders stay far from overflow territory.
  const FRAG = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif
    uniform vec2 u_res;
    uniform float u_time;
    uniform vec3 u_bg;
    uniform vec3 u_ink;
    uniform vec3 u_ink2;
    uniform vec3 u_star;
    uniform float u_coverage;
    uniform float u_maxInk;
    uniform sampler2D u_noise;
    uniform sampler2D u_bayer;

    float h21(vec2 p) {
      return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
    }

    void main() {
      vec2 px = vec2(gl_FragCoord.x, u_res.y - gl_FragCoord.y);
      vec2 p = px / u_res.y;
      float aspect = u_res.x / u_res.y;
      // The arc originates upper-right and descends toward the lower-left,
      // melting into the mask before it reaches the lockup text.
      vec2 c = vec2(aspect * (0.82 + 0.025 * sin(u_time * 0.05)), 1.9);
      float dx = p.x - c.x;
      float dy = p.y - c.y;
      float d = sqrt(dx * dx + dy * dy) - 1.72;
      float ang = atan(dy, dx);
      float m = 0.58 + 0.42 * (0.5 + 0.5
        * sin(3.0 * ang + u_time * 0.055)
        * sin(2.0 * ang + 1.3 - u_time * 0.034));
      float q = d / 0.052;
      float band = exp(-q * q) * 1.05 * m;
      float hq = d / 0.36;
      float halo = exp(-hq * hq) * 0.33 * m;
      float sky = 0.2 * exp(-(p.y * p.y) / 0.36);
      float tex = 0.55 + 0.75 * texture2D(
        u_noise, (px + vec2(u_time * 1.3, -u_time * 0.9)) / 128.0).r;
      float cBand = band * tex * u_coverage;
      float cOuter = (halo + sky) * tex * u_coverage;
      float th = texture2D(u_bayer, gl_FragCoord.xy / 8.0).r;
      vec3 col = u_bg;
      if (cBand > th) {
        col = u_bg + (u_ink - u_bg) * min(u_maxInk, 0.3 + cBand * 1.1);
      } else if (cOuter > th) {
        col = u_bg + (u_ink2 - u_bg) * min(u_maxInk, 0.3 + cOuter * 1.1) * 0.8;
      }
      // Sparse deterministic starfield with slow twinkle.
      vec2 cell = floor(px / 22.0);
      float r1 = h21(cell);
      if (r1 < 0.055) {
        vec2 spos = vec2(h21(cell + 1.7), h21(cell + 3.3)) * 22.0;
        if (floor(px) == floor(spos)) {
          float b = 0.22 + 0.5 * h21(cell + 5.1);
          float tw = h21(cell + 7.7);
          float gate = mix(1.0,
            0.5 + 0.5 * sin(u_time * (0.25 + tw) + r1 * 37.0),
            step(tw, 0.35));
          vec3 scol = h21(cell + 11.3) < 0.16 ? u_ink : u_star;
          col = col + (scol - col) * clamp(b * gate, 0.0, 1.0);
        }
      }
      gl_FragColor = vec4(col, 1.0);
    }
  `

  const root = document.querySelector<HTMLElement>('.dither-sky')
  const canvas = document.querySelector<HTMLCanvasElement>('.dither-sky-canvas')

  if (root && canvas) {
    const gl = canvas.getContext('webgl', {
      alpha: false,
      antialias: false,
      depth: false,
      stencil: false,
    })
    let palette = readPalette()
    // Start mid-cycle so the first (possibly only) frame is a composed one.
    let elapsed = 12.6

    const drawStatic = () => {
      // CPU fallback: one composed frame, no loop.
      const ctx = canvas.getContext('2d')
      if (!ctx) {
        // WebGL context exists but the program failed to build: settle for
        // clean ground rather than a blank canvas.
        if (gl) {
          const [r, g, b] = palette.bg
          gl.viewport(0, 0, canvas.width, canvas.height)
          gl.clearColor(r / 255, g / 255, b / 255, 1)
          gl.clear(gl.COLOR_BUFFER_BIT)
        }
        return
      }
      const rect = canvas.getBoundingClientRect()
      const vw = Math.max(320, rect.width || window.innerWidth)
      const vh = Math.max(240, rect.height || window.innerHeight)
      const scale = Math.max(1, Math.sqrt((vw * vh) / 4 / 1_300_000))
      const W = Math.max(160, Math.round(vw / 2 / scale))
      const H = Math.max(120, Math.round(vh / 2 / scale))
      canvas.width = W
      canvas.height = H
      const image = ctx.createImageData(W, H)
      const d = image.data
      const { bg, ink, ink2, star, coverage, maxInk } = palette
      const cx = W * (0.82 + 0.025 * Math.sin(elapsed * 0.05))
      const cy = H * 1.9
      const R = H * 1.72
      const phaseA = elapsed * 0.055
      const phaseB = 1.3 - elapsed * 0.034
      const texX = Math.floor(elapsed * 1.3)
      const texY = Math.floor(elapsed * -0.9)
      for (let y = 0; y < H; y++) {
        const dy = y - cy
        const sky = 0.2 * Math.exp(-((y / (H * 0.6)) ** 2))
        for (let x = 0; x < W; x++) {
          const dx = x - cx
          const dSq = dx * dx + dy * dy
          let band = 0
          let halo = 0
          if (dSq > (R - H * 1.15) ** 2 && dSq < (R + H * 1.15) ** 2) {
            const dist = Math.sqrt(dSq) - R
            const ang = Math.atan2(dy, dx)
            const mod =
              0.58 + 0.42 * (0.5 + 0.5 * Math.sin(3 * ang + phaseA) * Math.sin(2 * ang + phaseB))
            const q = dist / (H * 0.052)
            band = Math.exp(-q * q) * 1.05 * mod
            const hq = dist / (H * 0.36)
            halo = Math.exp(-hq * hq) * 0.33 * mod
          }
          const tex = 0.55 + 0.75 * noise[((y + texY) & 127) * 128 + ((x + texX) & 127)]
          const cBand = band * tex * coverage
          const cOuter = (halo + sky) * tex * coverage
          const o = (y * W + x) * 4
          let color: RGB | null = null
          let k = 0
          if (cBand > bayer[(y & 7) * 8 + (x & 7)]) {
            color = ink
            k = Math.min(maxInk, 0.3 + cBand * 1.1)
          } else if (cOuter > bayer[(y & 7) * 8 + (x & 7)]) {
            color = ink2
            k = Math.min(maxInk, 0.3 + cOuter * 1.1) * 0.8
          }
          if (color) {
            d[o] = bg[0] + (color[0] - bg[0]) * k
            d[o + 1] = bg[1] + (color[1] - bg[1]) * k
            d[o + 2] = bg[2] + (color[2] - bg[2]) * k
          } else {
            d[o] = bg[0]
            d[o + 1] = bg[1]
            d[o + 2] = bg[2]
          }
          d[o + 3] = 255
        }
      }
      const cellsX = Math.ceil(W / 22)
      const cellsY = Math.ceil(H / 22)
      for (let sy = 0; sy < cellsY; sy++) {
        for (let sx = 0; sx < cellsX; sx++) {
          const id = Math.imul(sx, 668265263) ^ Math.imul(sy, 374761393)
          const r = hash(id)
          if (r > 0.055) continue
          const px = sx * 22 + Math.floor(hash(id ^ 0x9e3779b9) * 22)
          const py = sy * 22 + Math.floor(hash(id ^ 0x85ebca6b) * 22)
          if (px >= W || py >= H) continue
          let brightness = 0.22 + 0.5 * hash(id ^ 0xc2b2ae35)
          const twinkleSeed = hash(id ^ 0x27d4eb2f)
          if (twinkleSeed < 0.35) {
            brightness *= 0.5 + 0.5 * Math.sin(elapsed * (0.25 + twinkleSeed) + r * 37)
          }
          const color = hash(id ^ 0x165667b1) < 0.16 ? ink : star
          const i = (py * W + px) * 4
          d[i] += (color[0] - d[i]) * brightness
          d[i + 1] += (color[1] - d[i + 1]) * brightness
          d[i + 2] += (color[2] - d[i + 2]) * brightness
        }
      }
      ctx.putImageData(image, 0, 0)
    }

    const buildRenderer = () => {
      if (!gl) return null
      const compile = (type: number, src: string) => {
        const sh = gl.createShader(type)
        if (!sh) return null
        gl.shaderSource(sh, src)
        gl.compileShader(sh)
        if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) return null
        return sh
      }
      const vs = compile(gl.VERTEX_SHADER, VERT)
      const fs = compile(gl.FRAGMENT_SHADER, FRAG)
      if (!vs || !fs) return null
      const program = gl.createProgram()
      if (!program) return null
      gl.attachShader(program, vs)
      gl.attachShader(program, fs)
      gl.linkProgram(program)
      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return null
      gl.useProgram(program)

      const quad = gl.createBuffer()
      gl.bindBuffer(gl.ARRAY_BUFFER, quad)
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW)
      const loc = gl.getAttribLocation(program, 'a_pos')
      gl.enableVertexAttribArray(loc)
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0)

      const makeTexture = (data: Uint8Array, size: number, filter: number) => {
        const tex = gl.createTexture()
        if (!tex) return null
        gl.bindTexture(gl.TEXTURE_2D, tex)
        gl.texImage2D(
          gl.TEXTURE_2D,
          0,
          gl.LUMINANCE,
          size,
          size,
          0,
          gl.LUMINANCE,
          gl.UNSIGNED_BYTE,
          data
        )
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.REPEAT)
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.REPEAT)
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, filter)
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, filter)
        return tex
      }

      const noiseTex = makeTexture(
        new Uint8Array(noise.map(v => Math.round(v * 255))),
        TEX,
        gl.LINEAR
      )
      const bayerTex = makeTexture(
        new Uint8Array(bayer.map(v => Math.round(v * 255))),
        8,
        gl.NEAREST
      )
      if (!noiseTex || !bayerTex) return null

      const u = (name: string) => gl.getUniformLocation(program, name)
      const uniforms = {
        res: u('u_res'),
        time: u('u_time'),
        bg: u('u_bg'),
        ink: u('u_ink'),
        ink2: u('u_ink2'),
        star: u('u_star'),
        coverage: u('u_coverage'),
        maxInk: u('u_maxInk'),
        noise: u('u_noise'),
        bayer: u('u_bayer'),
      }
      gl.uniform1i(uniforms.noise, 0)
      gl.uniform1i(uniforms.bayer, 1)
      gl.activeTexture(gl.TEXTURE0)
      gl.bindTexture(gl.TEXTURE_2D, noiseTex)
      gl.activeTexture(gl.TEXTURE1)
      gl.bindTexture(gl.TEXTURE_2D, bayerTex)

      const draw = (t: number) => {
        gl.viewport(0, 0, canvas.width, canvas.height)
        gl.uniform2f(uniforms.res, canvas.width, canvas.height)
        gl.uniform1f(uniforms.time, t)
        gl.uniform3f(uniforms.bg, palette.bg[0] / 255, palette.bg[1] / 255, palette.bg[2] / 255)
        gl.uniform3f(uniforms.ink, palette.ink[0] / 255, palette.ink[1] / 255, palette.ink[2] / 255)
        gl.uniform3f(
          uniforms.ink2,
          palette.ink2[0] / 255,
          palette.ink2[1] / 255,
          palette.ink2[2] / 255
        )
        gl.uniform3f(
          uniforms.star,
          palette.star[0] / 255,
          palette.star[1] / 255,
          palette.star[2] / 255
        )
        gl.uniform1f(uniforms.coverage, palette.coverage)
        gl.uniform1f(uniforms.maxInk, palette.maxInk)
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4)
      }

      return { draw }
    }

    const renderer = buildRenderer()

    // Tiny diagnostic hook (mirrors stencil.so's own): reports the active
    // renderer and measured frames per second.
    const diagnostics = { mode: renderer ? 'webgl' : 'cpu-static', fps: 0 }
    ;(window as unknown as Record<string, unknown>).__dithersky = diagnostics
    let fpsFrames = 0
    let fpsAt = performance.now()

    const resize = () => {
      const rect = canvas.getBoundingClientRect()
      const vw = Math.max(320, rect.width || window.innerWidth)
      const vh = Math.max(240, rect.height || window.innerHeight)
      const scale = Math.max(1, Math.sqrt((vw * vh) / 4 / 1_300_000))
      canvas.width = Math.max(160, Math.round(vw / 2 / scale))
      canvas.height = Math.max(120, Math.round(vh / 2 / scale))
      draw(elapsed)
    }

    const draw = (t: number) => {
      if (renderer) renderer.draw(t)
      else drawStatic()
    }

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
    let raf = 0
    let last = 0

    const tick = (now: number) => {
      raf = requestAnimationFrame(tick)
      const dt = now - last
      if (dt <= 0) return
      elapsed += Math.min(dt, 250) / 1000
      last = now
      draw(elapsed)
      fpsFrames++
      if (now - fpsAt >= 1000) {
        diagnostics.fps = Math.round((fpsFrames * 1000) / (now - fpsAt))
        fpsFrames = 0
        fpsAt = now
      }
    }

    const setMotion = () => {
      cancelAnimationFrame(raf)
      if (motionQuery.matches || !renderer) {
        draw(elapsed)
      } else {
        last = performance.now()
        raf = requestAnimationFrame(tick)
      }
    }

    let resizeTimer = 0
    const onResize = () => {
      window.clearTimeout(resizeTimer)
      resizeTimer = window.setTimeout(resize, 150)
    }

    const themeObserver = new MutationObserver(() => {
      palette = readPalette()
      draw(elapsed)
    })

    resize()
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    })
    window.addEventListener('resize', onResize, { passive: true })
    motionQuery.addEventListener('change', setMotion)

    // Reveal once the first frame is on the canvas.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        root.classList.add('is-live')
      })
    })

    setMotion()

    window.addEventListener(
      'pagehide',
      () => {
        cancelAnimationFrame(raf)
        themeObserver.disconnect()
        window.removeEventListener('resize', onResize)
      },
      { once: true }
    )
  }
</script>
