---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts'

const siteUrl = Astro.site?.toString()

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: siteUrl,
  inLanguage: 'en',
  author: {
    '@type': 'Person',
    name: 'Ben Shi',
    url: `${siteUrl}about/`,
    sameAs: [
      'https://github.com/hbish',
      'https://x.com/hbish',
      'https://au.linkedin.com/in/benshi',
      'https://keybase.io/hbish',
    ],
  },
  publisher: {
    '@type': 'Person',
    name: 'Ben Shi',
    url: `${siteUrl}about/`,
  },
})
---

<!-- Site-wide JSON-LD Schema -->
<script type="application/ld+json" set:html={schema} />
