---
import Container from '../layouts/Container.astro'
---

<Container title="Server Error - Ben Shi">
  <header class="page-header">
    <h1 class="page-header-title">500 — Server Error</h1>
  </header>

  <section class="text-center mt-10">
    <div class="text-6xl mb-6">⚠️</div>

    <div class="mb-8">
      <p class="text-lg mb-4">
        Oops! Something went wrong on our end. The server encountered an internal error or
        misconfiguration.
      </p>
      <p class="text-gray-600 mb-6">
        This is likely a temporary issue. Please try again in a few moments.
      </p>
    </div>
  </section>

  <script>
    // Set the current time for error reporting
    document.addEventListener('DOMContentLoaded', () => {
      const timeElement = document.getElementById('error-time')
      if (timeElement) {
        timeElement.textContent = new Date().toLocaleString()
      }
    })
  </script>
</Container>
