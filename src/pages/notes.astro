---
import Container from '../layouts/Container.astro'
import { getCollection, type CollectionEntry } from 'astro:content'

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .filter(n => !n.data.draft)

const notesByYear = new Map<number, CollectionEntry<'notes'>[]>()
notes.forEach(note => {
  const fullYear = note.data.date.getFullYear()
  if (notesByYear.get(fullYear)) {
    notesByYear.set(fullYear, notesByYear.get(fullYear)!.concat(note))
  } else {
    notesByYear.set(fullYear, [note])
  }
})

const newestYear = notes[0]?.data.date.getFullYear()
const oldestYear = notes[notes.length - 1]?.data.date.getFullYear()
const yearRange = newestYear === oldestYear ? `${newestYear}` : `${oldestYear} — ${newestYear}`
const metaLine = notes.length === 0 ? 'no scribbles' : `${notes.length} scribbles · ${yearRange}`

const isoDate = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(
    2,
    '0'
  )}`
---

<Container
  title="Notes - Ben Shi"
  description="Short technical notes and how-tos Ben Shi has collected over the years."
>
  <div>
    <header class="page-header">
      <h1 class="page-header-title">Notes</h1>
      <p class="page-header-meta">{metaLine}</p>
    </header>

    {
      notes.length === 0 ? (
        <div class="empty-state text-theme-muted">No scribbles yet.</div>
      ) : (
        Array.from(notesByYear).map(([year, yearNotes]) => (
          <section class="year-group" aria-label={`Notes from ${year}`}>
            <h2 class="year-label">{year}</h2>
            <ul class="post-list">
              {yearNotes.map(note => (
                <li>
                  <div class="post-row">
                    <time class="post-date" datetime={isoDate(note.data.date)}>
                      {note.data.date.toLocaleDateString(undefined, {
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                    <a class="post-link" href={`/notes/${note.slug}/`}>
                      {note.data.title}
                    </a>
                    {note.data.minutesRead && (
                      <span class="post-read">~{note.data.minutesRead} min read</span>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }

    <nav class="index-links" aria-label="More writing">
      <a href="/archive/">
        View all posts <span class="arrow" aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
</Container>

<style>
  .index-links {
    margin-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
  }

  .index-links .arrow {
    display: inline-block;
    transition: transform 0.18s ease;
  }

  .index-links a:hover .arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .index-links .arrow {
      transition: none;
    }
  }
</style>
