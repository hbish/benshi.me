---
import Header from '../components/Header.astro'
import DitherSky from '../components/DitherSky.astro'
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts'
---

<!doctype html>
<html lang="en">
  <Header title={SITE_TITLE} description={SITE_DESCRIPTION} />
  <body class="bg-theme text-theme transition-colors duration-300">
    <DitherSky />
    <main class="landing">
      <div class="landing-lockup">
        <h1 class="landing-name">Ben Shi</h1>
        <nav class="landing-menu" aria-label="Main navigation">
          <a href="/about/">about</a>
          <a href="/writing/">writing</a>
          <a href="/photos/">photos</a>
        </nav>
      </div>
    </main>
  </body>
</html>

<style>
  .landing {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }

  .landing-name {
    margin: 0;
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
    line-height: 1.1;
  }

  .landing-menu {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 1.25rem;
    font-family:
      ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .landing-menu a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 6px;
    transition:
      color 0.18s ease,
      text-decoration-color 0.18s ease;
  }

  .landing-menu a:hover {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  @media (prefers-reduced-motion: no-preference) {
    .landing-lockup {
      animation: landing-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .landing-menu {
      animation: landing-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both;
    }
  }

  @keyframes landing-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
